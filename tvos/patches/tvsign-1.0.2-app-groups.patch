 // ---------------------------------------------------------------- the developer portal
 
+#[test]
+fn app_group_conflict_recovers_only_when_the_exact_group_is_now_owned_by_the_team() {
+    for returned_identifier in [
+        Some("group.example.shared.TEAM"),
+        Some("group.other.TEAM"),
+        None,
+    ] {
+        let run = open_session(Apple::new(TwoFa::None), false, None, unavailable);
+        let session = run.result.as_ref().ok().expect("local session");
+        let lookups = Arc::new(Mutex::new(0));
+        let counter = lookups.clone();
+        let (url, seen) = serve(move |req| {
+            let mut response = dict(vec![
+                ("creationTimestamp", string("2026-11-13T20:00:00Z")),
+                ("resultCode", int(0)),
+                ("userLocale", string("en_US")),
+                ("protocolVersion", string("QH65B2")),
+                ("responseId", string("group-test")),
+            ]);
+            if req.path.ends_with("/addApplicationGroup.action") {
+                response.insert("resultCode".into(), int(35));
+                response.insert("userString".into(), string("Identifier not available"));
+            } else if req.path.ends_with("/listApplicationGroups.action") {
+                let mut count = counter.lock().unwrap();
+                *count += 1;
+                let groups = if *count > 1 {
+                    returned_identifier
+                        .map(|identifier| {
+                            Value::Dictionary(dict(vec![
+                                ("applicationGroup", string("opaque-group-id")),
+                                ("name", string("Shared group")),
+                                ("status", string("current")),
+                                ("prefix", string("TEAM")),
+                                ("identifier", string(identifier)),
+                            ]))
+                        })
+                        .into_iter()
+                        .collect()
+                } else {
+                    Vec::new()
+                };
+                response.insert("applicationGroupList".into(), Value::Array(groups));
+            } else {
+                panic!("unexpected local endpoint: {}", req.path);
+            }
+            Resp::plist(response)
+        });
+        crate::developer::TEST_DEVELOPER_HOST.with(|host| *host.borrow_mut() = Some(url));
+        let result = block_on(session.qh_ensure_app_group(
+            &"TEAM".to_string(),
+            &"Shared group".to_string(),
+            &"group.example.shared.TEAM".to_string(),
+        ));
+        if returned_identifier == Some("group.example.shared.TEAM") {
+            assert_eq!(result.unwrap().application_group, "opaque-group-id");
+        } else {
+            assert!(matches!(
+                result,
+                Err(Error::DeveloperApi {
+                    result_code: 35,
+                    ..
+                })
+            ));
+        }
+        assert_eq!(*lookups.lock().unwrap(), 2);
+        assert_eq!(
+            seen.lock()
+                .unwrap()
+                .iter()
+                .filter(|r| r.path.ends_with("/addApplicationGroup.action"))
+                .count(),
+            1
+        );
+    }
+}
